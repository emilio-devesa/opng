# Open Pastebin NG — Apache hardening (v0.8, Fases 0 y 3)
# ------------------------------------------------------------------
# Bloquea el acceso HTTP directo a ficheros que solo deben cargarse
# desde PHP (require/include) y nunca servirse a los visitantes.
# Compatible con Apache 2.4 (mod_authz_host).
# ------------------------------------------------------------------

<FilesMatch "^(config\.php|config\.example\.php|database\.php|rules\.xml)$">
    Require all denied
</FilesMatch>

# ------------------------------------------------------------------
# Sin listados de directorio (fix R7). Si un directorio no tiene
# index, Apache devuelve 403 en lugar de mostrar su contenido.
# ------------------------------------------------------------------
Options -Indexes

# ------------------------------------------------------------------
# Cabeceras de seguridad (fix R7). No hay recursos externos (JS/CSS
# se sirven en local), por lo que una CSP estricta es viable; se
# permite 'unsafe-inline' porque algunas vistas usan onclick y un
# <style> embebido.
# ------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# ------------------------------------------------------------------
# CVE-2026-109619 / CVE-2026-115560 (PHP "PHP2Shell", Oct 2026)
# Mitigacion oficial: deshabilitar session.upload_progress.
# OPNG no utiliza subidas de ficheros ni barras de progreso, por lo
# que esta funcionalidad se puede desactivar sin coste.
#
# Esta directiva solo aplica con mod_php. Si se usa PHP-FPM, fijar
# la opcion administrativamente en el pool (no anulable con ini_set):
#
#     php_admin_flag[session.upload_progress.enabled] = off
#
# Tras el cambio: reiniciar los workers por completo (restart, no
# reload) y verificar via phpinfo()/php-fpm -i en el SAPI HTTP.
# Mas informacion: audit v0.7, seccion 4 (CVE-2026-1096xx/115560).
# ------------------------------------------------------------------
<IfModule mod_php7.c>
    php_flag session.upload_progress.enabled 0
</IfModule>
<IfModule mod_php.c>
    php_flag session.upload_progress.enabled 0
</IfModule>
