# Open Pastebin NG — internal directory (v0.8, Fase 3)
# ------------------------------------------------------------------
# `src/includes/` solo debe cargarse con require/include desde PHP.
# Nunca se sirve directamente por HTTP (fix R7).
# Compatible con Apache 2.4 (mod_authz_core) y 2.2.
# ------------------------------------------------------------------

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
