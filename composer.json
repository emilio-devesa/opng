{
    "name": "emilio-devesa/opng",
    "description": "Open Pastebin NG — a modern, self-hosted pastebin",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2.35 <8.3.0 || >=8.3.36 <8.4.0 || >=8.4.27 <8.5.0 || >=8.5.12 <9.0.0",
        "ext-gd": "*",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "lint": "find src tools -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
