parameters:
    level: 5
    paths:
        - src
        - tools
    excludePaths:
        # Credenciales locales: no está en el repo y no debe analizarse.
        - src/config.php
    ignoreErrors:
        # Las credenciales llegan por require de config.php, que no se
        # versiona. Se declaran aquí para que el análisis sea idéntico
        # con y sin config.php presente.
        - '#Variable \$(mysql_server|mysql_username|mysql_password|mysql_dbname) might not be defined\.#'
    reportUnmatchedIgnoredErrors: false
