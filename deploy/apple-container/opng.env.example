# Open Pastebin NG - Apple Container environment (F3).
#
# Copy to opng.env, chmod 600, and replace every change-me value. Keep this
# file out of version control. The DB root password is only used by start.sh
# to initialize MariaDB; it is filtered out of the application container.
#
# If a TLS proxy terminates HTTPS in front of the app, set
# OPNG_FORCE_HTTPS=1 and OPNG_PUBLIC_URL=https://your.domain. Do not set
# OPNG_FORCE_HTTPS for plain http://127.0.0.1:8080, or login cookies will not
# be sent back.

OPNG_DB_HOST=opng-db
OPNG_DB_NAME=opng
OPNG_DB_USER=opng
OPNG_DB_PASS=change-me-runtime-password
OPNG_DB_ROOT_PASSWORD=change-me-root-password

OPNG_PUBLIC_URL=http://127.0.0.1:8080
OPNG_FORCE_HTTPS=
OPNG_STORAGE_QUOTA_BYTES=10737418240
OPNG_BACKUP_MAX_SECONDS=300
OPNG_BACKUP_MAX_BYTES=536870912
OPNG_AUTO_MIGRATE=1

# First-boot administrator. The entrypoint creates it only when all three
# values are present and no administrator exists yet. Remove
# OPNG_ADMIN_PASSWORD from this file after the first successful start.
OPNG_ADMIN_USERNAME=admin
OPNG_ADMIN_EMAIL=admin@example.com
OPNG_ADMIN_PASSWORD=change-me-at-least-12-bytes

TZ=Europe/Madrid
