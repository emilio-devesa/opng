# syntax=docker/dockerfile:1.7
# Open Pastebin NG - Apple Container image (F3).
#
# One application image with Nginx, PHP-FPM and supervisord. MariaDB runs in a
# separate official container on the private `opng-net` network.
#
# Build (Apple Container):
#   container build -t opng-app:1.1.0 -f deploy/apple-container/Containerfile .
#
# The image never contains secrets or src/config.php: configuration arrives
# through OPNG_* environment variables and config.example.php.

FROM php:8.3-fpm-alpine AS app

RUN apk add --no-cache \
        nginx \
        supervisor \
        curl \
        mariadb-client \
        tzdata \
        libpng \
        freetype \
        libjpeg-turbo \
        oniguruma \
    && apk add --no-cache --virtual .opng-build-deps \
        $PHPIZE_DEPS \
        libpng-dev \
        freetype-dev \
        libjpeg-turbo-dev \
        oniguruma-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" mysqli gd opcache mbstring \
    && apk del .opng-build-deps \
    && rm -rf /var/cache/apk/*

WORKDIR /var/www/opng

# Runtime code, schema migrations and operational tools. The package root is
# /var/www/opng so tools/*.php keep their ../src/config.php relationship.
COPY src/ /var/www/opng/src/
COPY database/ /var/www/opng/database/
COPY tools/ /var/www/opng/tools/
COPY deploy/php/opng.ini /usr/local/etc/php/conf.d/zz-opng.ini
COPY deploy/apple-container/php-fpm.conf /usr/local/etc/php-fpm.d/zz-opng.conf
COPY deploy/apple-container/nginx.conf /etc/nginx/nginx.conf
COPY deploy/apple-container/supervisord.conf /etc/supervisord.conf
COPY deploy/apple-container/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY deploy/apple-container/healthcheck.sh /usr/local/bin/healthcheck.sh

# The real config.php is excluded by .containerignore/.dockerignore. Always
# regenerate it from the env-driven example and remove the default FPM pools
# (www.conf, docker.conf and zz-docker.conf) so only the constrained [opng]
# pool listens on 9000.
RUN rm -f /usr/local/etc/php-fpm.d/www.conf \
    /usr/local/etc/php-fpm.d/docker.conf \
    /usr/local/etc/php-fpm.d/zz-docker.conf \
    && rm -f /var/www/opng/src/config.php /var/www/opng/tools/seed.php \
    && cp /var/www/opng/src/config.example.php /var/www/opng/src/config.php \
    && chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh \
    && chmod 0600 /var/www/opng/src/config.php \
    && mkdir -p /run/nginx /var/lib/nginx /var/lib/php/sessions /backups \
    && chown -R www-data:www-data /var/www/opng /var/lib/php/sessions /var/lib/nginx /backups

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/usr/local/bin/healthcheck.sh"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
